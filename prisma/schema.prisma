// Prisma schema file for Korean Zero
// Official Prisma 7 PostgreSQL setup

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlockType {
  TEXT
  HANGUL
  VOCABULARY
  GRAMMAR
  DIALOGUE
  AUDIO
  CALLOUT
  EXAMPLE
  IMAGE
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_BLANK
  ARRANGE_SENTENCE
  LISTENING_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
  MATCHING
  ORDERING
  TRANSLATION
  WRITING
  PRONUNCIATION
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum CardState {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

model Course {
  id           String        @id @default(uuid())
  slug         String        @unique
  title        String
  description  String
  level        String        @default("BEGINNER")
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  chapters    Chapter[]
  enrollments Enrollment[]

  @@index([status, displayOrder])
  @@index([slug])
}

model Chapter {
  id           String        @id @default(uuid())
  courseId     String
  slug         String
  title        String
  description  String?
  displayOrder Int           @default(0)
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, slug])
  @@index([courseId, displayOrder])
  @@index([slug])
  @@index([status])
}

model Lesson {
  id               String        @id @default(uuid())
  chapterId        String
  slug             String        @unique
  title            String
  summary          String?
  estimatedMinutes Int           @default(15)
  level            String?
  tags             String[]      @default([])
  learningObjectives String[]    @default([])
  displayOrder     Int           @default(0)
  status           ContentStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  chapter      Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  blocks       LessonBlock[]
  vocabularies Vocabulary[]
  exercises    Exercise[]
  progresses   LessonProgress[]
  aiImports    AiLessonImport[]

  @@index([chapterId, displayOrder])
  @@index([slug])
  @@index([status])
}

// Atomic receipt for confirmed AI imports; drafts are never persisted here.
model AiLessonImport {
  idempotencyKey String   @id
  userId         String
  requestHash    String
  generationMetadata Json?
  lessonId       String?
  createdAt      DateTime @default(now())
  lesson         Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([lessonId])
}

// Shared per-admin rate window and expiring generation lease; no draft content.
model AiLessonGenerationLimit {
  userId String @id
  windowStart DateTime
  requestCount Int @default(0)
  activeRequestId String?
  leaseExpiresAt DateTime?
}

model LessonBlock {
  id           String    @id @default(uuid())
  lessonId     String
  type         BlockType
  displayOrder Int       @default(0)
  content      Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, displayOrder])
}

model Vocabulary {
  id                    String   @id @default(uuid())
  lessonId              String
  hangul                String
  romanization          String
  englishMeaning        String
  vietnameseMeaning     String
  partOfSpeech          String?
  difficulty            Int?
  tags                  String[] @default([])
  audioUrl              String?
  exampleSentenceHangul String?
  exampleSentenceVi     String?
  displayOrder          Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  reviewCards ReviewCard[]

  @@index([lessonId, displayOrder])
  @@index([hangul])
}

model Exercise {
  id           String        @id @default(uuid())
  lessonId     String
  title        String
  description  String?
  displayOrder Int           @default(0)
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lesson    Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  ExerciseAttempt[]

  @@index([lessonId, displayOrder])
  @@index([status])
}

model Question {
  id            String       @id @default(uuid())
  exerciseId    String
  type          QuestionType
  prompt        String
  audioUrl      String?
  correctAnswer String?
  content       Json?
  explanation   String?
  displayOrder  Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  exercise       Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  options        QuestionOption[]
  attemptAnswers AttemptAnswer[]

  @@index([exerciseId, displayOrder])
}

model QuestionOption {
  id           String   @id @default(uuid())
  questionId   String
  text         String
  isCorrect    Boolean  @default(false)
  explanation  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, displayOrder])
}

model Enrollment {
  id          String    @id @default(uuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id          String               @id @default(uuid())
  userId      String
  lessonId    String
  status      LessonProgressStatus @default(NOT_STARTED)
  score       Int                  @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, status])
  @@index([lessonId])
}

model DailyStudyStat {
  id               String   @id @default(uuid())
  userId           String
  date             String // "YYYY-MM-DD" in Asia/Ho_Chi_Minh
  lessonsCompleted Int      @default(0)
  reviewsCompleted Int      @default(0)
  minutesSpent     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model ExerciseAttempt {
  id             String          @id @default(uuid())
  idempotencyKey String?         @unique
  userId         String
  exerciseId     String
  startedAt      DateTime        @default(now())
  submittedAt    DateTime?
  score          Int             @default(0)
  maxScore       Int             @default(0)
  percentage     Int             @default(0)
  isPassing      Boolean         @default(false)
  answers        AttemptAnswer[]

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId])
  @@index([exerciseId])
}

model AttemptAnswer {
  id               String   @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  textAnswer       String?
  isCorrect        Boolean  @default(false)
  score            Int      @default(0)

  attempt  ExerciseAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model SystemHealth {
  id        String   @id @default(uuid())
  status    String   @default("healthy")
  checkedAt DateTime @default(now())
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?   @default("STUDENT")
  sessions      Session[]
  accounts      Account[]

  enrollments      Enrollment[]
  lessonProgresses LessonProgress[]
  dailyStudyStats  DailyStudyStat[]
  exerciseAttempts ExerciseAttempt[]
  reviewCards      ReviewCard[]
  reviewLogs       ReviewLog[]

  @@unique([email])
  @@map("user")
}

model ReviewCard {
  id             String       @id @default(uuid())
  userId         String
  vocabularyId   String
  state          CardState    @default(NEW)
  intervalDays   Float        @default(0)
  easeFactor     Float        @default(2.5)
  repetitions    Int          @default(0)
  lapses         Int          @default(0)
  dueAt          DateTime     @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary     Vocabulary   @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  reviewLogs     ReviewLog[]

  @@unique([userId, vocabularyId])
  @@index([userId, dueAt])
  @@index([vocabularyId])
}

model ReviewLog {
  id                String       @id @default(uuid())
  cardId            String
  userId            String
  rating            ReviewRating
  intervalBefore    Float
  intervalAfter     Float
  easeFactorBefore  Float
  easeFactorAfter   Float
  repetitionsBefore Int
  repetitionsAfter  Int
  stateBefore       CardState
  stateAfter        CardState
  idempotencyKey    String?      @unique
  reviewedAt        DateTime     @default(now())

  card              ReviewCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([userId, reviewedAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
