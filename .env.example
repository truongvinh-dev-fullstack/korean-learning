# Database connection string (PostgreSQL)
# Example format: postgresql://postgres:<your-password>@localhost:5432/korean_zero?schema=public
DATABASE_URL=""
# Optional session/direct URL for Prisma migrations; defaults to DATABASE_URL locally.
DIRECT_URL=""
POSTGRES_PASSWORD=""

# Next.js Server Port
PORT=3000

# Node Environment
NODE_ENV="development"

# Better Auth Configuration
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI authoring — server only; never use NEXT_PUBLIC_* for these settings.
# openai | http (custom bridge) | mock (dev/test only) | disabled (explicit opt-out).
# Production startup rejects missing/invalid config and mock. No automatic fallback.
AI_LESSON_PROVIDER="disabled"
AI_LESSON_MODEL=""
AI_LESSON_BASE_URL="https://api.openai.com/v1"
# Required only for the custom http bridge; returns draft JSON directly.
AI_LESSON_ENDPOINT=""
AI_LESSON_API_KEY=""
# Total HTTP budget includes all attempts/backoff; capped at 120 seconds.
AI_LESSON_TIMEOUT_MS=90000
AI_LESSON_MAX_ATTEMPTS=3
AI_LESSON_MAX_OUTPUT_TOKENS=12000
# Per-admin shared PostgreSQL window, plus one active generation lease.
AI_LESSON_RATE_LIMIT=5
AI_LESSON_RATE_WINDOW_MS=600000
# Comma-separated remote audio URLs verified by the content team.
AI_LESSON_VERIFIED_AUDIO_URLS=""
# For local dev ONLY: AI_LESSON_PROVIDER=mock (production rejects it).
