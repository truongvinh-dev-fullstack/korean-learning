# Copy to .env.production.local; never commit the filled file.
# Supabase Dashboard > Connect > Transaction pooler (runtime, port 6543).
# Replace placeholders and URL-encode the database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt"
# Supabase Dashboard > Connect > Session pooler (migrations, port 5432).
# Copy the actual hostname from Supabase; it can differ from this example.
DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt"
BETTER_AUTH_SECRET=""
# Set both to the stable Vercel Production domain, without a trailing slash.
BETTER_AUTH_URL="https://YOUR_PROJECT.vercel.app"
NEXT_PUBLIC_APP_URL="https://YOUR_PROJECT.vercel.app"
NODE_ENV="production"

# Server-only AI provider. Explicit disabled allows deployment before adding a real key/model.
# Production rejects missing provider, invalid config and mock.
AI_LESSON_PROVIDER="disabled"
AI_LESSON_MODEL=""
AI_LESSON_API_KEY=""
AI_LESSON_BASE_URL="https://api.openai.com/v1"
AI_LESSON_ENDPOINT=""
AI_LESSON_TIMEOUT_MS=90000
AI_LESSON_MAX_ATTEMPTS=3
AI_LESSON_MAX_OUTPUT_TOKENS=12000
AI_LESSON_RATE_LIMIT=5
AI_LESSON_RATE_WINDOW_MS=600000
AI_LESSON_VERIFIED_AUDIO_URLS=""
